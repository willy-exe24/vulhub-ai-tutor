# SQLite database file, relative to the backend/ directory unless absolute.
DATABASE_PATH=data/vulhub_tutor.db

# Which provider the tutor uses by default (openai or anthropic). Can also be
# switched at runtime from the Settings page.
DEFAULT_AI_PROVIDER=openai

# Leave a key unset to run that provider in stub mode: the AI endpoints still
# work end-to-end, returning clearly-labeled placeholder content instead of
# calling out to a real model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: the lab library above works with zero VM setup. Set these only if
# you want the dashboard to show your Kali/Vulhub VM power status and let you
# start/stop them from the app (via vmrun — ships with VMware Workstation/
# Player, must be on PATH or in a standard install location). These are
# bootstrap defaults only — edit them from the Settings page after first run.
KALI_VMX_PATH=
VULHUB_VMX_PATH=

# Directory to scan for .vmx files when auto-discovering VMs (Settings page).
# Defaults to VMware Workstation's standard Windows location if unset.
VM_LIBRARY_PATH=
